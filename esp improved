void onEvent(AsyncWebSocket *server, AsyncWebSocketClient *client, AwsEventType type, void *arg, uint8_t *data, size_t len) {
  if (type == WS_EVT_CONNECT) {
    Serial.printf("WebSocket კლიენტი დაკავშირდა: #%u\n", client->id());
    for (int i = 0; i < MAX_BOXES; i++) {
      if (boxData[i].length() > 0) client->text(boxData[i]);
    }
  } else if (type == WS_EVT_DISCONNECT) {
    Serial.printf("WebSocket კლიენტი გაეთიშა: #%u\n", client->id());
  }
}

void handleChunk(String chunk) {
  chunk.trim();
  if (chunk.length() == 0) return;
  storeBox(chunk);
  ws.textAll(chunk);
}

void setup() {
  Serial.begin(115200);
  hc12.begin(9600);

  WiFi.mode(WIFI_AP);
  WiFi.softAP(ap_ssid, ap_pass);

  Serial.println("\nAccess Point გააქტიურდა");
  Serial.print("Wi-Fi: ");
  Serial.println(ap_ssid);
  Serial.print("IP: ");
  Serial.println(WiFi.softAPIP());   // 192.168.4.1

  ws.onEvent(onEvent);
  server.addHandler(&ws);

  server.on("/", HTTP_GET, [](AsyncWebServerRequest *request) {
    request->send_P(200, "text/html", HTML_INDEX);
  });

  server.begin();
}

void loop() {
  ws.cleanupClients();

  if (hc12.available()) {
    String incoming = hc12.readStringUntil('\n');
    incoming.trim();
    if (incoming.length() == 0) return;

    Serial.print("HC-12-დან მიღებულია: ");
    Serial.println(incoming);

    // ჯაჭვის დაშლა '|' სიმბოლოთი, თითო ყუთი ცალ-ცალკე
    int start = 0;
    int sep = incoming.indexOf('|');
    while (sep != -1) {
      handleChunk(incoming.substring(start, sep));
      start = sep + 1;
      sep = incoming.indexOf('|', start);
    }
    handleChunk(incoming.substring(start));
  }
}
