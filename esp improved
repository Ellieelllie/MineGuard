// თითო ყუთის ბოლო მონაცემი (ახალ კლიენტს ყველა ყუთი ერთდროულად გაეგზავნება)
#define MAX_BOXES 8
String boxId[MAX_BOXES];
String boxData[MAX_BOXES];

void storeBox(const String& chunk) {
  int c = chunk.indexOf(',');
  if (c <= 0) return;
  String id = chunk.substring(0, c);
  for (int i = 0; i < MAX_BOXES; i++) {
    if (boxId[i].length() == 0 || boxId[i] == id) {
      boxId[i] = id;
      boxData[i] = chunk;
      return;
    }
  }
}

