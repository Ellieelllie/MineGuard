<script>
const LIM=400,CLEAR=350,WIN=30,MINP=5,SLOPE=1.0,RISE=15,ETA=90,LOST=10000,KEEP=300;
const $=i=>document.getElementById(i);
const boxes={},order=[],events=[],names={};
let ws,demo=false,demoT,sound=false,acked=false,prevRank=0,actx,t0=0;
try{Object.assign(names,JSON.parse(localStorage.getItem('mgNames')||'{}'))}catch(e){}
const nm=id=>names[id]||id, hms=d=>new Date(d).toTimeString().slice(0,8);

function trend(p){const n=p.length,a=p[0].t;let st=0,sv=0,stt=0,stv=0;
 for(const q of p){const x=q.t-a;st+=x;sv+=q.v;stt+=x*x;stv+=x*q.v}
 const d=n*stt-st*st;if(!d)return null;const s=(n*stv-st*sv)/d,ic=(sv-s*st)/n,sp=p[n-1].t-a;
 return{s,f:ic+s*sp,sp}}

function mk(id){boxes[id]={h:[],last:0,t:NaN,hu:NaN,g:0,v:1,hi:0,ga:false,sh:[],lvl:'init',txt:'',rate:null,lg:null};
 order.push(id);const c=document.createElement('div');c.className='card lost';c.id='c-'+id;
 c.innerHTML=`<button class="x ctl" onclick="rm('${id}')">✕</button><h2 id="n-${id}" title="სახელის შესაცვლელად ორჯერ დააჭირეთ" ondblclick="ren('${id}')"></h2>
 <div class="dr"><span>ტემპერატურა</span><span class="v" id="t-${id}">--</span></div>
 <div class="dr"><span>ტენიანობა</span><span class="v" id="u-${id}">--</span></div>
 <div class="dr"><span>გაზი</span><span class="v" id="g-${id}">--</span></div>
 <div class="dr"><span>ტრენდი</span><span class="v" id="r-${id}">--</span></div>
 <div class="dr"><span>ვიბრაცია</span><span id="v-${id}">--</span></div>
 <canvas id="s-${id}" width="240" height="36"></canvas>
 <div class="st" id="st-${id}"></div><div class="fr" id="fr-${id}"></div>`;
 $('grid').appendChild(c)}
function addBox(){const id=(prompt('ID:','B'+(order.length+1))||'').trim().toUpperCase();
 if(!id||boxes[id])return;mk(id);render()}
function rm(id){const i=order.indexOf(id);if(i>-1)order.splice(i,1);delete boxes[id];$('c-'+id).remove();render()}
function ren(id){const v=prompt('სახელი:',nm(id));if(v===null)return;names[id]=v.trim()||id;
 try{localStorage.setItem('mgNames',JSON.stringify(names))}catch(e){}render()}

function pkt(raw){const p=raw.split(',');if(p.length<5)return;const b=boxes[p[0].trim()];if(!b)return;
 const now=Date.now();b.t=parseFloat(p[1]);b.hu=parseFloat(p[2]);b.g=parseInt(p[3]);b.v=parseInt(p[4]);b.last=now;
 b.h.push({t:now/1000,v:b.g});while(b.h.length&&now/1000-b.h[0].t>KEEP)b.h.shift();
 if(b.g>LIM)b.hi++;else if(b.g<CLEAR){b.hi=0;b.ga=false}
 if(b.hi>=2)b.ga=true;
 b.sh=b.sh.filter(x=>now-x<10000);if(b.v===0)b.sh.push(now);
 b.lg={time:now,g:b.g,t:b.t}}
function onMsg(d){d.split('|').forEach(c=>{c=c.trim();if(c)pkt(c)});render()}

function ev(b){const now=Date.now();
 if(!b.last||now-b.last>LOST)return{l:'lost',x:b.last?'კავშირი დაკარგულია':'მონაცემი არ მიღებულა'};
 if(b.ga)return{l:'alert',x:'გაზი ზღვარს აჭარბებს!'};
 if(b.sh.length>=3)return{l:'alert',x:b.sh.length+' რყევა 10 წმ-ში!'};
 const w=b.h.filter(q=>now/1000-q.t<=WIN);let rate=null;
 if(w.length>=MINP){const r=trend(w);if(r){rate=r.s*60;
  if(r.s>SLOPE&&r.s*r.sp>=RISE){const e=(LIM-r.f)/r.s;
   if(e<=ETA)return{l:'warn',x:'გაზი სწრაფად იზრდება, ზღვრამდე ~'+Math.max(1,Math.round(e))+' წმ',rate}}}}
 if(b.sh.length)return{l:'warn',x:'რყევა დაფიქსირდა',rate};
 return{l:'ok',x:w.length>=MINP?'ნორმა':'მონაცემებს ვაგროვებთ...',rate}}

function spark(id,b){const c=$('s-'+id),g=c.getContext('2d'),W=c.width,H=c.height;g.clearRect(0,0,W,H);
 if(b.h.length<2)return;const now=Date.now()/1000,mx=Math.max(LIM*1.2,...b.h.map(q=>q.v));
 const y=v=>H-2-(v/mx)*(H-4),x=t=>W-((now-t)/KEEP)*W;
 g.strokeStyle='#ef4444';g.setLineDash([4,3]);g.beginPath();g.moveTo(0,y(LIM));g.lineTo(W,y(LIM));g.stroke();g.setLineDash([]);
 g.strokeStyle='#38bdf8';g.lineWidth=1.5;g.beginPath();b.h.forEach((q,i)=>i?g.lineTo(x(q.t),y(q.v)):g.moveTo(x(q.t),y(q.v)));g.stroke()}

const RK={ok:0,lost:1,warn:2,alert:3},CL={ok:'ok-t',lost:'lost-t',warn:'warn-t',alert:'alert-t'};
function log(m){events.unshift({t:Date.now(),m});if(events.length>200)events.pop()}

function render(){const now=Date.now();let top='ok',miss=null;const res={};
 order.forEach(id=>{const b=boxes[id],r=ev(b);res[id]=r;
  if(b.lvl==='init')b.lvl=r.l;else if(b.lvl!==r.l){
   if(r.l==='lost')log('📡 '+nm(id)+': კავშირი გაწყდა'+(b.lg?' (ბოლო გაზი '+b.lg.g+')':''));
   else if(r.l==='ok')log('✓ '+nm(id)+': '+(b.lvl==='lost'?'კავშირი აღდგა':'ნორმას დაუბრუნდა'));
   else log((r.l==='alert'?'🚨 ':'⚠️ ')+nm(id)+': '+r.x);b.lvl=r.l}
  if(RK[r.l]>RK[top])top=r.l});
 for(let i=order.length-1;i>=0;i--){if(res[order[i]].l==='lost'){miss=order[i];break}}
 order.forEach(id=>{const b=boxes[id],r=res[id],c=$('c-'+id);if(!c)return;
  c.className='card '+(r.l==='ok'?'':r.l);$('n-'+id).innerText='ყუთი '+nm(id);
  const lost=r.l==='lost';
  if(!lost){$('t-'+id).innerText=isNaN(b.t)?'შეცდომა':b.t.toFixed(1)+'°C';
   $('u-'+id).innerText=isNaN(b.hu)?'შეცდომა':b.hu.toFixed(1)+' %';$('g-'+id).innerText=b.g;
   $('r-'+id).innerText=r.rate==null?'--':(r.rate>0?'+':'')+r.rate.toFixed(0)+' / წთ';
   const v=$('v-'+id);v.innerText=b.v===0?'რყევა!':'ნორმა';v.className=b.v===0?'alert-t':'ok-t'}
  $('st-'+id).innerText=(r.l==='alert'?'🚨 ':r.l==='warn'?'⚠️ ':r.l==='lost'?'📡 ':'✓ ')+r.x;$('st-'+id).className='st '+CL[r.l];
  $('fr-'+id).innerText=lost&&b.lg?'ბოლო მონაცემი '+hms(b.lg.time)+': გაზი '+b.lg.g+', '+(isNaN(b.lg.t)?'--':b.lg.t.toFixed(1)+'°C')
   :b.last?'განახლდა '+Math.round((now-b.last)/1000)+' წმ წინ':'';
  spark(id,b)});
 // chain map: ESP <- last box ... first box
 let h='<div class="node esp">ESP<small>ზედაპირი</small></div>';
 for(let i=order.length-1;i>=0;i--){const id=order[i],l=res[id].l;
  h+='<div class="link '+(l==='lost'?'bad':'')+'"></div><div class="node '+l+'">'+nm(id)+'<small>'+(l==='lost'?'გათიშულია':l==='ok'?'ცოცხალია':l==='warn'?'გაფრთხილება':'საფრთხე')+'</small></div>'}
 $('chain').innerHTML=h;
 $('brk').innerText=miss?'ჯაჭვი გაწყვეტილია: '+nm(miss)+'-ზე ან მის წინა რგოლთან':'';
 const bad=top==='alert',wr=top==='warn'||top==='lost';
 $('sys').className=bad?'bad':wr?'warn':'safe';
 $('sys').innerHTML=bad?'🚨 საშიშროება':wr?'⚠️ გაფრთხილება':'✓ უსაფრთხო';
 $('log').innerHTML=events.slice(0,40).map(e=>'<div><b>'+hms(e.t)+'</b>'+e.m+'</div>').join('')||'<div>მოვლენა არ არის</div>';
 const rk=RK[top];if(rk>prevRank&&rk>=2)acked=false;prevRank=rk;window._top=top;
 $('esp').innerText=demo?'დემო':ws&&ws.readyState===1?'ESP ✓':'ESP ✗';
 $('esp').style.color=demo?'#818cf8':ws&&ws.readyState===1?'#4ade80':'#ef4444'}

// alarms
function toggleSound(){sound=!sound;$('bSnd').innerText=sound?'🔊 ხმა':'🔇 ხმა';$('bSnd').classList.toggle('on',sound);
 if(sound&&!actx)try{actx=new (window.AudioContext||window.webkitAudioContext)()}catch(e){}}
function ack(){acked=true}
function beep(f){if(!actx)return;const o=actx.createOscillator(),g=actx.createGain();o.frequency.value=f;o.connect(g);g.connect(actx.destination);
 g.gain.value=.15;o.start();o.stop(actx.currentTime+.25)}
setInterval(()=>{const t=window._top;if(acked||!sound)return;
 if(t==='alert'){beep(880);if(navigator.vibrate)navigator.vibrate([300,100,300])}else if(t==='warn')beep(440)},1500);

// demo simulator
function demoTick(){const ph=(Date.now()-t0)/1000%100;
 order.forEach((id,i)=>{let g=80+i*10+Math.random()*8,v=1;
  if(id==='B2'&&ph>10&&ph<70)g=80+(ph-10)*7+Math.random()*8;
  if(id==='B3'&&ph>30&&ph<34)v=0;
  if(id==='B1'&&ph>55&&ph<80)return;
  pkt(id+','+(24+i+Math.random()).toFixed(1)+','+(55+i*3).toFixed(1)+','+Math.round(g)+','+v)});render()}
function toggleDemo(on){demo=on===undefined?!demo:on;$('demo').style.display=demo?'block':'none';
 $('bDemo').classList.toggle('on',demo);$('bDemo').innerText=demo?'⏹ დემო':'▶ დემო';
 clearInterval(demoT);if(demo){t0=Date.now();demoT=setInterval(demoTick,2000);demoTick()}render()}

function csv(){let s='time,box,gas\n';order.forEach(id=>boxes[id].h.forEach(q=>s+=new Date(q.t*1000).toISOString()+','+id+','+q.v+'\n'));
 const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([s],{type:'text/csv'}));a.download='mine_guard_log.csv';a.click()}

function conn(){if(location.protocol==='file:')return;
 try{ws=new WebSocket((location.protocol==='https:'?'wss://':'ws://')+location.host+'/ws');
  ws.onmessage=e=>{if(!demo)onMsg(e.data)};ws.onclose=()=>{render();setTimeout(conn,2000)};ws.onopen=render}catch(e){setTimeout(conn,3000)}}

window.addEventListener('load',()=>{['B1','B2','B3'].forEach(mk);render();conn();setInterval(render,1000);
 if(location.protocol==='file:'||location.hash==='#demo')toggleDemo(true)});
</script></body></html>
