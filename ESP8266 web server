                <div class="data-row"><span>გაზი:</span> <span id="g-${cleanID}">--</span></div>
                <div class="data-row"><span>ვიბრაცია:</span> <span id="v-${cleanID}">--</span></div>
            `;
            grid.appendChild(newCard);
        }

        function removeBox(boxID) {
            let card = document.getElementById(card-${boxID});
            if (card) {
                card.remove();
                activeBoxes = activeBoxes.filter(id => id !== boxID);
            }
        }

