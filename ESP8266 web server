#include <Arduino.h>
#include <ESP8266WiFi.h>
#include <ESPAsyncWebServer.h>
#include <ESPAsyncTCP.h>
#include <SoftwareSerial.h>

// საკუთარი Wi-Fi ქსელის პარამეტრები (Access Point)
const char* ap_ssid = "Mine_Guard";
const char* ap_pass = "mineguard123";

// ობიექტები
AsyncWebServer server(80);
AsyncWebSocket ws("/ws");

// HC-12 SoftwareSerial: GPIO14 (D5) -> TX, GPIO12 (D6) -> RX
SoftwareSerial hc12(14, 12);

String lastData = "";

