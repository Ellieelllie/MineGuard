            activeBoxes.push(cleanID);

            let grid = document.getElementById('boxesGrid');
            let newCard = document.createElement('div');
            newCard.className = 'card';
            newCard.id = card-${cleanID};
            newCard.innerHTML = `
                <button class="remove-btn" onclick="removeBox('${cleanID}')">✕</button>
                <h2>ყუთი ${cleanID}</h2>
                <div class="data-row"><span>ტემპერატურა:</span> <span class="val" id="t-${cleanID}">--</span></div>
