void onEvent(AsyncWebSocket *server, AsyncWebSocketClient *client, AwsEventType type, void *arg, uint8_t *data, size_t len) {
  if (type == WS_EVT_CONNECT) {
    Serial.printf("WebSocket კლიენტი დაკავშირდა: #%u\n", client->id());
    if (lastData.length() > 0) {
      client->text(lastData);
    }
  } else if (type == WS_EVT_DISCONNECT) {
    Serial.printf("WebSocket კლიენტი გაეთიშა: #%u\n", client->id());
  }
}

void setup() {
  Serial.begin(115200);
  hc12.begin(9600);

  // ვრთავთ ESP8266-ს Access Point (Wi-Fi წერტილის) რეჟიმში
  WiFi.mode(WIFI_AP);
  WiFi.softAP(ap_ssid, ap_pass);

  Serial.println("\nAccess Point რეჟიმი გააქტიურდა!");
  Serial.print("Wi-Fi ქსელის სახელი: ");
  Serial.println(ap_ssid);
  Serial.print("IP მისამართი: ");
  Serial.println(WiFi.softAPIP()); // 192.168.4.1

  ws.onEvent(onEvent);
  server.addHandler(&ws);

  server.on("/", HTTP_GET, [](AsyncWebServerRequest *request){
    request->send_P(200, "text/html", HTML_INDEX);
  });

  server.begin();
}

void loop() {
  ws.cleanupClients();

  if (hc12.available()) {
    String incoming = hc12.readStringUntil('\n');
    incoming.trim();

    if (incoming.length() > 0) {
      lastData = incoming;
      Serial.print("HC-12-დან მიღებულია: ");
      Serial.println(incoming);

      // ჯაჭვის დაშლა '|' სიმბოლოთი და თითოეულის ცალ-ცალკე გაგზავნა
      int startIndex = 0;
      int separatorIndex = incoming.indexOf('|');
      
      while (separatorIndex != -1) {
        String singleBox = incoming.substring(startIndex, separatorIndex);
        singleBox.trim();
        if (singleBox.length() > 0) {
          ws.textAll(singleBox);
          delay(10);
        }
        startIndex = separatorIndex + 1;
        separatorIndex = incoming.indexOf('|', startIndex);
      }
      
      String lastBox = incoming.substring(startIndex);
      lastBox.trim();
      if (lastBox.length() > 0) {
        ws.textAll(lastBox);
      }
    }
  }
}
